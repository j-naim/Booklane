{{> header}}

<section class="relative overflow-hidden">
  <div class="dot-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:py-28">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/5 px-3 py-1 text-xs font-medium text-accent dark:border-accent-light/40 dark:bg-accent-light/10 dark:text-accent-light">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-60 motion-safe:animate-ping dark:bg-accent-light"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent dark:bg-accent-light"></span>
        </span>
        Live inventory
      </span>

      <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl">Your next trip, booked.</h1>
      <p class="mt-6 max-w-xl text-lg text-zinc-600 dark:text-zinc-400">
        Hand-picked trips with clear pricing and real availability, updated live as our team manages the inventory.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/travel" class="rounded-full bg-accent px-6 py-3 font-medium text-white hover:bg-accent-hover dark:bg-accent-light dark:text-zinc-950">
          Browse trips
        </a>
        <span class="font-mono text-sm text-zinc-500">// updated in real time</span>
      </div>
    </div>

        {{#if featured}}
      <a href="/travel" class="group block w-full max-w-md overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-lg lg:justify-self-end dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-light">
        <div class="relative aspect-[4/3] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
          <img src="{{featured.imageUrl}}" alt="{{featured.name}}" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
          <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 font-mono text-xs font-semibold text-accent backdrop-blur dark:bg-zinc-950/80 dark:text-accent-light">Next departure</span>
        </div>
        <div class="p-5">
          <div class="flex flex-wrap items-baseline gap-x-2 text-sm">
            <span class="font-mono font-semibold text-accent dark:text-accent-light">{{featured.code}}</span>
            <span class="text-zinc-400">·</span>
            <span class="text-zinc-600 dark:text-zinc-400">{{featured.location}}</span>
          </div>
          <h2 class="mt-1 text-xl font-semibold">{{featured.name}}</h2>
          <div class="mt-4 flex items-end justify-between border-t border-zinc-200 pt-4 text-sm dark:border-zinc-800">
            <div>
              <span class="block text-xs uppercase tracking-wide text-zinc-500">Departs</span>
              <span class="font-medium">{{featured.startFormatted}}</span>
            </div>
            <div class="text-right">
              <span class="block text-xs uppercase tracking-wide text-zinc-500">Per person</span>
              <span class="font-mono font-semibold">{{featured.priceFormatted}}</span>
            </div>
          </div>
        </div>
      </a>
    {{/if}}
  </div>
</section>

<section class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:grid-cols-3">
    <div>
      <span class="font-mono text-sm text-accent dark:text-accent-light">01</span>
      <h2 class="mt-2 font-semibold">Curated trips</h2>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Every listing is reviewed and managed by our team before it goes live.</p>
    </div>
    <div>
      <span class="font-mono text-sm text-accent dark:text-accent-light">02</span>
      <h2 class="mt-2 font-semibold">Clear pricing</h2>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Per-person prices up front. No surprises at checkout.</p>
    </div>
    <div>
      <span class="font-mono text-sm text-accent dark:text-accent-light">03</span>
      <h2 class="mt-2 font-semibold">Live inventory</h2>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Trips update the moment they change, straight from our booking system.</p>
    </div>
  </div>
</section>

{{> footer}}