{{> header}}

<section class="mx-auto max-w-6xl px-6 py-16">
  <div class="mb-10">
    <h1 class="text-4xl font-bold tracking-tight">Trips</h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400">Every trip below is pulled live from the Booklane API.</p>
  </div>

  {{#if message}}
    <div class="rounded-xl border border-dashed border-zinc-300 bg-zinc-50 px-6 py-16 text-center text-zinc-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-400">
      {{message}}
    </div>
  {{/if}}

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#each listings}}
      <article class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
        <div class="aspect-[4/3] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
          <img src="{{this.imageUrl}}" alt="{{this.name}}" loading="lazy"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
        </div>

        <div class="flex flex-1 flex-col p-5">
          <div class="flex items-center gap-2 text-sm">
            <span class="font-mono font-semibold text-accent dark:text-accent-light">{{this.code}}</span>
            <span class="text-zinc-400">·</span>
            <span class="text-zinc-600 dark:text-zinc-400">{{this.resort}}</span>
          </div>

          <h2 class="mt-2 text-xl font-semibold">{{this.name}}</h2>

          <div class="mb-5 mt-2 text-sm text-zinc-600 dark:text-zinc-400">{{{this.description}}}</div>

          <dl class="mt-auto grid grid-cols-3 gap-3 border-t border-zinc-200 pt-4 text-sm dark:border-zinc-800">
            <div>
              <dt class="text-xs uppercase tracking-wide text-zinc-500">Length</dt>
              <dd class="mt-1 font-medium">{{this.length}}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-zinc-500">Starts</dt>
              <dd class="mt-1 font-medium">{{this.startFormatted}}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-zinc-500">Per person</dt>
              <dd class="mt-1 font-mono font-semibold">{{this.priceFormatted}}</dd>
            </div>
          </dl>
        </div>
      </article>
    {{/each}}
  </div>
</section>

{{> footer}}